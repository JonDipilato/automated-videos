{
  "name": "automated-video-generator",
  "version": "1.0.0",
  "description": "Automated AI-powered video generation pipeline using Grok, OpenAI, and ElevenLabs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "generate": "ts-node src/index.ts generate",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "ai",
    "video-generation",
    "automation",
    "grok",
    "openai",
    "elevenlabs",
    "ffmpeg"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.62.1",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "date-fns": "^4.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "sharp": "^0.33.5",
    "cosine-similarity": "^1.0.1",
    "natural": "^8.0.1",
    "sqlite3": "^5.1.7",
    "googleapis": "^144.0.0",
    "fb": "^2.0.0",
    "twitter-api-v2": "^1.17.2",
    "linkedin-api-client": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.7",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.3",
    "ts-node": "^10.9.2",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.13"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
