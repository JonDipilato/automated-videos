LINKEDIN_ORGANIZATION_ID=your_linkedin_organization_id_here

# Video Duration Configuration
# =============================
# Duration Settings (all in seconds):
VIDEO_SEGMENT_DURATION=7    # Duration of each video segment
TRANSITION_DURATION=1        # Duration of transitions between segments
MAX_VIDEO_LENGTH=60          # Default maximum video length (changed from 180s for social media)
INTRO_DURATION=3             # Duration of intro sequence
OUTRO_DURATION=3             # Duration of outro sequence
OUTPUT_RESOLUTION=1080       # Output resolution (1080p)

# Duration Priority: CLI flag (--max-length) > ENV variable > Default (60s)
# Content duration = MAX_VIDEO_LENGTH - INTRO_DURATION - OUTRO_DURATION
# Example: 60s video = 3s intro + 54s content + 3s outro
# Use CLI to override: npm start generate -- --max-length=14

# Database
DATABASE_PATH=./data/content.db

# CTA Configuration
CTA_TEXT=Want to learn how I created this? Link in bio!
CTA_URL=https://your-lead-generation-url.com
CTA_POSITION=end

# Scheduling Configuration
AUTO_PUBLISH=false
SCHEDULE_STRATEGY=optimal  # Options: optimal, random, manual, smart, immediate
SCHEDULE_TIMEZONE=UTC      # Your timezone (e.g., America/New_York, Europe/London, UTC)
SCHEDULE_DELAY_HOURS=0     # For immediate strategy
SCHEDULE_AVOID_WEEKENDS=false
SCHEDULE_SPREAD_POSTS=false  # Spread posts across multiple days
SCHEDULE_MIN_GAP_MINUTES=15  # Minimum gap between posts

# Manual Scheduling (only used when SCHEDULE_STRATEGY=manual)
# SCHEDULE_MANUAL_TIME=2025-01-25T14:00:00Z

# Advanced Settings
MAX_RETRIES=3
RETRY_DELAY_MS=1000
PARALLEL_GENERATION=true
CACHE_PROMPTS=true
